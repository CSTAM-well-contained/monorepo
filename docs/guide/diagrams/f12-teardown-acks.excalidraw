      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Why the route goes first: as long as any gateway maps team5... -> 10.20.0.40, that IP must not belong to anyone else (edges.md).\nWhy the port goes last: the Neutron port is OpenStack's own lock on the IP. We keep it until nothing in our system points at the IP.",
      "roughness": 1,
      "roundness": null,
      "seed": 643345565,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Why the route goes first: as long as any gateway maps team5... -> 10.20.0.40, that IP must not belong to anyone else (edges.md).\nWhy the port goes last: the Neutron port is OpenStack's own lock on the IP. We keep it until nothing in our system points at the IP.",
      "textAlign": "left",
      "updated": 1792177973960,
      "version": 1,
      "versionNonce": 1354141039,
      "verticalAlign": "top"
    },
