# /etc/cstam/gwagent.env on a gateway (mode 0600, owner cstam). One file per gateway.
# GWAGENT_OPTS must be the same for the bootstrap and the agent: both units read it.
GWAGENT_OPTS=-name gw1 -cpd http://10.20.0.5:8080 -haproxy-user haproxy
VRRP_IFACE=ens3
CSTAM_GATEWAY_TOKEN=<same value as in cpd.env>
