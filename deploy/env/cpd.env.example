# /etc/cstam/cpd.env on the control plane (mode 0600, owner cstam).
CPD_LISTEN=10.20.0.5:8080
CPD_WORKERS=4
CSTAM_DB_DSN=postgres:///cstam?host=/var/run/postgresql
CSTAM_ADMIN_TOKEN=<openssl rand -hex 24>
CSTAM_GATEWAY_TOKEN=<openssl rand -hex 24>
CSTAM_DRIVER=openstack
OS_CLOUD=cstam
OS_CLIENT_CONFIG_FILE=/etc/cstam/clouds.yaml
# from `pulumi stack output` in infra/pulumi
CSTAM_NETWORK_ID=<networkId>
CSTAM_SUBNET_ID=<subnetId>
CSTAM_TEAM_SG_ID=<teamSecGroupId>
